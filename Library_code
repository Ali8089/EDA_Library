            <div class="card">
                <h2>Dataset Summary</h2>
                <p><strong>Total Rows:</strong> {self.df.shape[0]}</p>
                <p><strong>Total Columns:</strong> {self.df.shape[1]}</p>
                <p><strong>Target Column:</strong> {self.target_col if self.target_col else 'None'}</p>
            </div>
        """

        for plot_data in self._encoded_plots:
            html_content += f"""
            <div class="card">
                <h2>{plot_data['title']}</h2>
                <img src="data:image/png;base64,{plot_data['image']}" alt="{plot_data['title']}" />
            </div>
            """

        html_content += "</body></html>"

        report_filename = os.path.join(self.save_dir, "eda_report.html")
        with open(report_filename, "w", encoding="utf-8") as f:
            f.write(html_content)

        self.report_path_ = os.path.abspath(report_filename)
        self._log(f"Report generated successfully: {self.report_path_}")

        if self.export_pdf:
            try:
                from weasyprint import HTML
                pdf_filename = os.path.join(self.save_dir, "eda_report.pdf")
                HTML(string=html_content).write_pdf(pdf_filename)
                self._log(f"PDF exported successfully: {os.path.abspath(pdf_filename)}")
            except ImportError:
                self._log("Notice: 'weasyprint' not installed. PDF export skipped.")

        return self.report_path_

    def run_all(self, steps: Optional[List[str]] = None) -> 'DataAnalyzer':
        """
        Executes the complete EDA pipeline or a custom subset of steps.
        
        Available Steps:
        'summarize', 'data_quality', 'outliers', 'bivariate_stats', 'feature_importance',
        'multicollinearity', 'feature_interactions', 'missingness_plot', 'bivariate_plot',
        'multivariate_plot', 'time_series_plot'
        """
        all_steps = {
            'summarize': self.summarize,
            'data_quality': self.data_quality_report,
            'outliers': self.detect_outliers,
            'bivariate_stats': self.run_bivariate_stats,
            'feature_importance': self.compute_feature_importance,
            'multicollinearity': self.detect_multicollinearity,
            'feature_interactions': self.analyze_feature_interactions,
            'missingness_plot': self.plot_missingness,
            'bivariate_plot': self.plot_bivariate,
            'multivariate_plot': self.plot_multivariate,
            'time_series_plot': self.plot_time_series
        }

        execution_sequence = steps if steps else list(all_steps.keys())

        for step in execution_sequence:
            if step in all_steps:
                all_steps[step]()
            else:
                self._log(f"Warning: Step '{step}' is unrecognized and was skipped.")

        if self.download:
            self.generate_report()

        return self



